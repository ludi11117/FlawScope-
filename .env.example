# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
# cp .env.example .env

# ===== 必填 =====
SILICONFLOW_API_KEY=your_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===== 模型（可选，均有默认值）=====
DIAGNOSIS_MODEL=Qwen/Qwen2.5-14B-Instruct
JUDGE_MODEL=Qwen/Qwen2.5-72B-Instruct
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 判官独立网关（可选，默认复用 SILICONFLOW_BASE_URL）=====
# JUDGE_BASE_URL=

# ===== LLM 参数（可选）=====
# LLM_TEMPERATURE=0.1
# LLM_REQUEST_TIMEOUT=60
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF=1.5

# ===== 编排参数（可选）=====
# MAX_DEBATE_ROUNDS=3
# RETRIEVAL_K=3
# BM25_K=3
# RRF_K=60          # 混合检索 RRF 融合平滑系数，越大越弱化高排名优势
# GRAPH_RECURSION_LIMIT=100   # 图执行最大步数；不设时用框架默认的 10007，最坏情况能烧掉上万步配额
# RETRIEVAL_DEVICE_FILTER=false
#   ↑ 检索时按设备 metadata 过滤。**默认关闭，开启前必须先用 build_knowledge_base.py 重建向量库**
#     （旧库没有 metadata，带 where 条件查询会召回为空 → 全线误降级）。
#     是否默认开启牵动误降级指标，属待决策项，见 docs/修复报告-批次C.md。

# ===== 成本规则（可选）=====
# LABOR_RATE_PER_HOUR=150
# PARTS_PRICE_JSON={"主轴轴承":850,"润滑脂":80,"冷却风扇":300}

# ===== 数据库 / 日志（可选）=====
# DB_PATH=diagnosis_history.db
# CHROMA_PERSIST_DIR=chroma_db
# LOG_LEVEL=INFO
# LOG_JSON=false

# ===== 服务端口（可选）=====
# API_HOST=0.0.0.0
# API_PORT=8000
# HEALTH_CACHE_TTL=60   # /health 结果缓存秒数，0 = 每次都真探（会反复调用 LLM）
# MAX_CONCURRENT_DIAGNOSES=4   # 同时在跑的诊断上限；超出的请求直接返回 503（而不是无声排队）

# ===== CORS（生产部署**必须**改）=====
# 允许跨域的前端来源。默认只放行本机开发端口（5173 Vite / 8501 Streamlit 对照）。
# ⚠️ 公网部署时把实际前端域名加进来，否则浏览器会拦掉所有请求。
# docker-compose.yml 里前端经 nginx 暴露在 8080，所以容器场景至少要带上它。
# 刻意不用 ["*"]：带凭据的请求下通配符会被浏览器拒绝，且放开任意源等于把 API 暴露给任何网站。
# CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]

# ===== 安全（可选）=====
# API_KEY=              # 设置后业务接口需带 X-API-Key 请求头；留空则不做鉴权（本地开发默认）
#                       # ⚠️ 设置后 /health?fresh=true 也会强制校验（它会真调 LLM + Embedding）
# MAX_IMAGE_BASE64_CHARS=8000000   # 单张图片 base64 长度上限（约 6MB 原图）
